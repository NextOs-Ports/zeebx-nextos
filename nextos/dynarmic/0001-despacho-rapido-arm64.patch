+    // Zeebx/NextOS: tabela de despacho rápido. O backend arm64 não implementa o FastDispatchHint,
+    // então todo salto indireto (bx rN, ldr pc, blx rN, e todo retorno que o RSB perde) voltava ao
+    // despachante C++ e procurava o bloco no robin_map. No Mali-450 (A53 a 1 GHz) isso era 9% da
+    // CPU no Need for Speed Carbon. A tabela é mapeada direto pelo hash do descritor e consultada
+    // pelo próprio código emitido em `return_to_dispatcher`; só a falha chama o C++.
+    struct FastDispatchEntry {
+        u64 location_descriptor;
+        CodePtr code_ptr;
+    };
+    static constexpr size_t fast_dispatch_bits = 14;
+    static constexpr size_t fast_dispatch_size = size_t(1) << fast_dispatch_bits;
+
+    static u64 FastDispatchIndex(u64 descriptor) {
+        // Tem de bater com o cálculo emitido no prelúdio (A32AddressSpace::EmitPrelude).
+        u32 h = static_cast<u32>(descriptor) ^ static_cast<u32>(descriptor >> 32);
+        h ^= h >> 16;
+        return (h >> 2) & (fast_dispatch_size - 1);
+    }
+
+    CodePtr GetOrEmitAndCache(IR::LocationDescriptor descriptor) {
+        const CodePtr ptr = GetOrEmit(descriptor);
+        FastDispatchEntry& e = fast_dispatch_table[FastDispatchIndex(descriptor.Value())];
+        e.location_descriptor = descriptor.Value();
+        e.code_ptr = ptr;
+        return ptr;
+    }
+
+    CodePtr GetFast(IR::LocationDescriptor descriptor) {
+        const FastDispatchEntry& e = fast_dispatch_table[FastDispatchIndex(descriptor.Value())];
+        if (e.location_descriptor == descriptor.Value()) {
+            return e.code_ptr;
+        }
+        return GetOrEmitAndCache(descriptor);
+    }
